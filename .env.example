# ============================================================
# Veloura Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ---- Runtime ------------------------------------------------
NODE_ENV=production

# ---- Server -------------------------------------------------
# Port the NestJS API listens on (Railway injects PORT automatically;
# PORT_API is the manual fallback used in main.ts)
PORT_API=3000

# ---- MongoDB ------------------------------------------------
# Used in apps/veloura-api/src/database/database.module.ts
# The active URI is chosen based on NODE_ENV:
#   production  → MONGO_PROD
#   everything else → MONGO_DEV
MONGO_PROD=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/veloura?retryWrites=true&w=majority
MONGO_DEV=mongodb://localhost:27017/veloura

# ---- Auth / JWT ---------------------------------------------
# Used in apps/veloura-api/src/components/auth/auth.module.ts
# Generate a strong random string: openssl rand -hex 32
SECRET_TOKEN=replace_with_a_strong_random_secret
